<?xml version="1.0" encoding="utf-8"?>
<odoo><data noupdate="1">
    <record id="ir_cron_event_application_status_sync" model="ir.cron" forcecreate="True">
        <field name="name">Event Application Status Sync</field>
        <field name="model_id" ref="event.model_event_event"/>
        <field name="state">code</field>
        <field name="code">model._cron_auto_sync_event_stage_status()</field>
        <field name="user_id" ref="base.user_root"/>
        <field name="interval_number">15</field>
        <field name="interval_type">minutes</field>
        <field name="nextcall" eval="(DateTime.now() + timedelta(minutes=15)).strftime('%Y-%m-%d %H:%M:%S')"/>
    </record>
</data></odoo>
