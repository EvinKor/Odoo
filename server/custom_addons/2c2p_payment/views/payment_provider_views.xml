<odoo>
  <record id="payment_provider_form_2c2p" model="ir.ui.view">
    <field name="name">payment.provider.form.2c2p</field>
    <field name="model">payment.provider</field>
    <field name="inherit_id" ref="payment.payment_provider_form"/>
    <field name="arch" type="xml">
      <xpath expr="//group[@name='provider_configuration']" position="inside">
        <group attrs="{'invisible': [('code', '!=', '2c2p')]}">
          <field name="_2c2p_env"/>
          <field name="_2c2p_merchant_id"/>
          <field name="_2c2p_secret_key" password="True"/>
        </group>
      </xpath>
    </field>
  </record>
</odoo>
