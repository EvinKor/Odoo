<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="event_index_topbar_custom" inherit_id="website_event.index_topbar">
        
        <xpath expr="//div[contains(@class, 'o_wevent_index_topbar_filters')]" position="replace">
                        <div class="o_wevent_index_topbar_filters d-flex flex-wrap align-items-center gap-2">
                <style>
                    :root {
                        --mrbur-blue-950: #2353A3;
                        --mrbur-blue-900: #2353A3;
                        --mrbur-blue-800: #718FC2;
                        --mrbur-blue-700: #8CA4CC;
                        --mrbur-ice-100: #E2E8F3;
                        --mrbur-ice-200: #E2E8F3;
                        --mrbur-surface: #E2E8F3;
                    }
                    .o_wevent_index,
                    .o_wevent_event {
                        background: radial-gradient(circle at top right, #E2E8F3 0%, #f6f8fc 45%, #ffffff 100%);
                    }
                    .o_wevent_event .o_wevent_event_content,
                    .o_wevent_event #o_wevent_event_main_sidebar .o_wevent_sidebar_block {
                        background: #ffffff;
                        border: 1px solid #c4d1e6;
                        border-radius: 14px;
                        box-shadow: 0 8px 20px rgba(35, 83, 163, 0.10);
                    }
                    .o_wevent_index_topbar_filters {
                        background: linear-gradient(140deg, var(--mrbur-blue-900) 0%, var(--mrbur-blue-800) 70%, var(--mrbur-blue-700) 100%);
                        border: 1px solid rgba(21, 56, 120, 0.2);
                        border-radius: 14px;
                        padding: 1rem;
                        box-shadow: 0 8px 24px rgba(21, 56, 120, 0.16);
                    }
                    .o_wevent_index_topbar_filters h2 {
                        color: #ffffff;
                        font-weight: 700;
                        letter-spacing: 0.02em;
                    }
                    .mrbur-active-label {
                        color: #dfe9ff !important;
                    }
                    .mrbur-filter-btn.btn.btn-light {
                        background: #ffffff;
                        border-color: #c0cfe5;
                        color: var(--mrbur-blue-900);
                        font-weight: 600;
                    }
                    .mrbur-filter-btn.btn.btn-light:hover,
                    .mrbur-filter-btn.btn.btn-light:focus {
                        background: var(--mrbur-ice-100);
                        border-color: #b1c3df;
                        color: var(--mrbur-blue-900);
                    }
                    .mrbur-dropdown-menu.dropdown-menu {
                        border: 1px solid #c0cfe5;
                        border-radius: 10px;
                        box-shadow: 0 10px 26px rgba(35, 83, 163, 0.14);
                    }
                    .mrbur-dropdown-menu .dropdown-item.active,
                    .mrbur-dropdown-menu .dropdown-item:active {
                        background-color: var(--mrbur-blue-700);
                        color: #ffffff;
                    }
                    .mrbur-count-badge {
                        background: var(--mrbur-ice-100) !important;
                        color: var(--mrbur-blue-900) !important;
                        border: 1px solid #c0cfe5;
                    }
                    .mrbur-active-filter {
                        background: #ffffff !important;
                        color: var(--mrbur-blue-900) !important;
                        border: 1px solid #c0cfe5;
                        font-weight: 600;
                    }
                    .mrbur-filter-remove {
                        color: var(--mrbur-blue-900) !important;
                        font-size: 1rem;
                        line-height: 1;
                    }
                    .mrbur-clear-btn {
                        border-color: #ffffff;
                        color: #ffffff;
                    }
                    .mrbur-clear-btn:hover,
                    .mrbur-clear-btn:focus {
                        background: #ffffff;
                        color: var(--mrbur-blue-900);
                        border-color: #ffffff;
                    }
                    .mrbur-tag-badge {
                        background: var(--mrbur-ice-100) !important;
                        color: var(--mrbur-blue-900) !important;
                        border: 1px solid #c0cfe5;
                    }
                    .o_wevent_events_list article {
                        border: 1px solid #c4d1e6;
                        border-radius: 14px;
                        overflow: hidden;
                        box-shadow: 0 8px 22px rgba(35, 83, 163, 0.10);
                        background: #ffffff;
                    }
                    .o_wevent_index .btn-primary,
                    .o_wevent_event .btn-primary,
                    .o_wereg_confirmed .btn-primary,
                    #attendee_registration .btn-primary {
                        background-color: var(--mrbur-blue-800);
                        border-color: var(--mrbur-blue-800);
                        color: #ffffff;
                    }
                    .o_wevent_index .btn-primary:hover,
                    .o_wevent_event .btn-primary:hover,
                    .o_wereg_confirmed .btn-primary:hover,
                    #attendee_registration .btn-primary:hover {
                        background-color: var(--mrbur-blue-900);
                        border-color: var(--mrbur-blue-900);
                    }
                    .o_wevent_index .btn-secondary,
                    .o_wevent_event .btn-secondary,
                    #attendee_registration .btn-secondary {
                        background-color: var(--mrbur-ice-100);
                        border-color: #c0cfe5;
                        color: var(--mrbur-blue-900);
                    }
                    .o_wevent_index .btn-secondary:hover,
                    .o_wevent_event .btn-secondary:hover,
                    #attendee_registration .btn-secondary:hover {
                        background-color: #d5dfef;
                        border-color: #b1c3df;
                        color: var(--mrbur-blue-900);
                    }
                    .o_wevent_index .form-control,
                    .o_wevent_event .form-control,
                    #attendee_registration .form-control {
                        border-color: #c0cfe5;
                        background-color: #ffffff;
                    }
                    .o_wevent_index .form-control:focus,
                    .o_wevent_event .form-control:focus,
                    #attendee_registration .form-control:focus {
                        border-color: var(--mrbur-blue-700);
                        box-shadow: 0 0 0 0.2rem rgba(45, 90, 167, 0.2);
                    }
                    #attendee_registration .modal-content {
                        border: 1px solid #c4d1e6;
                        border-radius: 14px;
                        box-shadow: 0 14px 34px rgba(35, 83, 163, 0.2);
                    }
                    #attendee_registration .modal-header {
                        background: linear-gradient(120deg, var(--mrbur-blue-900), var(--mrbur-blue-700));
                        color: #ffffff;
                    }
                    #attendee_registration .modal-header .btn-close {
                        filter: invert(1);
                    }
                </style>
                <div class="d-flex flex-wrap align-items-center gap-2 flex-grow-1">
                <h2 class="my-0 me-3">Filters</h2>
                
                <!-- Date Filter -->
                <div class="dropdown d-none d-lg-block">
                    <a href="#" role="button" class="btn btn-light dropdown-toggle mrbur-filter-btn" data-bs-toggle="dropdown" data-bs-display="static">
                        <t t-if="current_date == 'old'">Past Events</t>
                        <t t-elif="current_date == 'today'">Today</t>
                        <t t-elif="current_date == 'week'">This Week</t>
                        <t t-elif="current_date == 'month'">This Month</t>
                        <t t-else="">Upcoming Events</t>
                    </a>
                    <div class="dropdown-menu mrbur-dropdown-menu">
                        <a t-attf-href="/event?{{ keep_query('type', 'specialty', 'case', 'country', date='upcoming') }}"
                           t-attf-class="dropdown-item #{'active' if current_date in ('upcoming', None, False) else ''}">
                            Upcoming Events
                        </a>
                        <a t-attf-href="/event?{{ keep_query('type', 'specialty', 'case', 'country', date='today') }}"
                           t-attf-class="dropdown-item #{'active' if current_date == 'today' else ''}">
                            Today
                        </a>
                        <a t-attf-href="/event?{{ keep_query('type', 'specialty', 'case', 'country', date='week') }}"
                           t-attf-class="dropdown-item #{'active' if current_date == 'week' else ''}">
                            This Week
                        </a>
                        <a t-attf-href="/event?{{ keep_query('type', 'specialty', 'case', 'country', date='month') }}"
                           t-attf-class="dropdown-item #{'active' if current_date == 'month' else ''}">
                            This Month
                        </a>
                        <a t-attf-href="/event?{{ keep_query('type', 'specialty', 'case', 'country', date='old') }}"
                           t-attf-class="dropdown-item #{'active' if current_date == 'old' else ''}">
                            Past Events
                        </a>
                    </div>
                </div>
                
                <!-- Type Filter -->
                <div class="dropdown d-none d-lg-block" t-if="event_types">
                    <a href="#" role="button" class="btn btn-light dropdown-toggle mrbur-filter-btn" data-bs-toggle="dropdown" data-bs-display="static">
                        <t t-if="current_type">
                            <t t-foreach="event_types" t-as="event_type">
                                <t t-if="current_type == str(event_type.id)">
                                    <t t-esc="event_type.name"/>
                                </t>
                            </t>
                        </t>
                        <t t-else="">Type</t>
                    </a>
                    <div class="dropdown-menu mrbur-dropdown-menu">
                        <a t-attf-href="/event?{{ keep_query('date', 'specialty', 'case', 'country') }}"
                           t-attf-class="dropdown-item #{'active' if not current_type else ''}">
                            All Types
                        </a>
                        <t t-foreach="event_types" t-as="event_type">
                            <a t-attf-href="/event?{{ keep_query('date', 'specialty', 'case', 'country', type=event_type.id) }}"
                               t-attf-class="dropdown-item #{'active' if current_type == str(event_type.id) else ''}">
                                <t t-esc="event_type.name"/>
                            </a>
                        </t>
                    </div>
                </div>
                
                <!-- Specialty Filter -->
                <div class="dropdown d-none d-lg-block">
                    <a href="#" role="button" class="btn btn-light dropdown-toggle mrbur-filter-btn" data-bs-toggle="dropdown" data-bs-display="static">
                        <t t-if="current_specialty">
                            <t t-esc="current_specialty"/>
                        </t>
                        <t t-else="">Specialty</t>
                    </a>
                    <div class="dropdown-menu mrbur-dropdown-menu" style="max-height: 400px; overflow-y: auto;">
                        <a t-attf-href="/event?{{ keep_query('date', 'type', 'case', 'country') }}"
                           t-attf-class="dropdown-item d-flex align-items-center justify-content-between #{'active' if not current_specialty else ''}">
                            All Specialties
                        </a>
                        <t t-foreach="specialties or []" t-as="specialty">
                            <a t-attf-href="/event?{{ keep_query('date', 'type', 'case', 'country', specialty=specialty['id']) }}"
                               t-attf-class="dropdown-item d-flex align-items-center justify-content-between #{'active' if current_specialty == specialty['name'] else ''}">
                                <t t-esc="specialty['name']"/>
                                <span class="badge text-bg-light ms-2 mrbur-count-badge">
                                    <t t-esc="specialty.get('event_count', 0)"/>
                                </span>
                            </a>
                        </t>
                    </div>
                </div>
                
                <!-- Case Filter -->
                <div class="dropdown d-none d-lg-block">
                    <a href="#" role="button" class="btn btn-light dropdown-toggle mrbur-filter-btn" data-bs-toggle="dropdown" data-bs-display="static">
                        <t t-if="current_case">
                            <t t-esc="current_case"/>
                        </t>
                        <t t-else="">Cases</t>
                    </a>
                    <div class="dropdown-menu mrbur-dropdown-menu" style="max-height: 400px; overflow-y: auto;">
                        <a t-attf-href="/event?{{ keep_query('date', 'type', 'specialty', 'country') }}"
                           t-attf-class="dropdown-item d-flex align-items-center justify-content-between #{'active' if not current_case else ''}">
                            All Cases
                        </a>
                        <t t-foreach="cases or []" t-as="case_item">
                            <a t-attf-href="/event?{{ keep_query('date', 'type', 'specialty', 'country', case=case_item['id']) }}"
                               t-attf-class="dropdown-item d-flex align-items-center justify-content-between #{'active' if current_case == case_item['name'] else ''}">
                                <t t-esc="case_item['name']"/>
                                <span class="badge text-bg-light ms-2 mrbur-count-badge">
                                    <t t-esc="case_item.get('event_count', 0)"/>
                                </span>
                            </a>
                        </t>
                    </div>
                </div>
                
                <!-- Country Filter -->
                <div class="dropdown d-none d-lg-block">
                    <a href="#" role="button" class="btn btn-light dropdown-toggle mrbur-filter-btn" data-bs-toggle="dropdown" data-bs-display="static">
                        <t t-if="current_country_custom">
                            <t t-esc="current_country_custom"/>
                        </t>
                        <t t-else="">Country</t>
                    </a>
                    <div class="dropdown-menu mrbur-dropdown-menu" style="max-height: 400px; overflow-y: auto;">
                        <a t-attf-href="/event?{{ keep_query('date', 'type', 'specialty', 'case') }}"
                           t-attf-class="dropdown-item d-flex align-items-center justify-content-between #{'active' if not current_country_custom else ''}">
                            All Countries
                        </a>
                        <t t-foreach="custom_countries or []" t-as="country">
                            <a t-attf-href="/event?{{ keep_query('date', 'type', 'specialty', 'case', country=country['id']) }}"
                               t-attf-class="dropdown-item d-flex align-items-center justify-content-between #{'active' if current_country_custom == country['name'] else ''}">
                                <t t-esc="country['name']"/>
                                <span class="badge text-bg-light ms-2 mrbur-count-badge">
                                    <t t-esc="country.get('event_count', 0)"/>
                                </span>
                            </a>
                        </t>
                    </div>
                </div>
                
                <!-- Active Filters Display & Clear Button -->
                <t t-if="current_date or current_type or current_specialty or current_case or current_country_custom">
                    <div class="d-flex align-items-center gap-2 ms-3">
                        <span class="small mrbur-active-label">Active filters:</span>
                        
                        <t t-if="current_date and current_date != 'upcoming'">
                            <span class="badge d-flex align-items-center gap-1 mrbur-active-filter">
                                <t t-esc="current_date"/>
                                <a t-attf-href="/event?{{ keep_query('type', 'specialty', 'case', 'country') }}" 
                                   class="text-decoration-none ms-1 mrbur-filter-remove">&#215;</a>
                            </span>
                        </t>
                        
                        <t t-if="current_type">
                            <span class="badge d-flex align-items-center gap-1 mrbur-active-filter">
                                Type: <t t-esc="current_type"/>
                                <a t-attf-href="/event?{{ keep_query('date', 'specialty', 'case', 'country') }}" 
                                   class="text-decoration-none ms-1 mrbur-filter-remove">&#215;</a>
                            </span>
                        </t>
                        
                        <t t-if="current_specialty">
                            <span class="badge d-flex align-items-center gap-1 mrbur-active-filter">
                                <t t-esc="current_specialty"/>
                                <a t-attf-href="/event?{{ keep_query('date', 'type', 'case', 'country') }}" 
                                   class="text-decoration-none ms-1 mrbur-filter-remove">&#215;</a>
                            </span>
                        </t>
                        
                        <t t-if="current_case">
                            <span class="badge d-flex align-items-center gap-1 mrbur-active-filter">
                                <t t-esc="current_case"/>
                                <a t-attf-href="/event?{{ keep_query('date', 'type', 'specialty', 'country') }}" 
                                   class="text-decoration-none ms-1 mrbur-filter-remove">&#215;</a>
                            </span>
                        </t>
                        
                        <t t-if="current_country_custom">
                            <span class="badge d-flex align-items-center gap-1 mrbur-active-filter">
                                <t t-esc="current_country_custom"/>
                                <a t-attf-href="/event?{{ keep_query('date', 'type', 'specialty', 'case') }}" 
                                   class="text-decoration-none ms-1 mrbur-filter-remove">&#215;</a>
                            </span>
                        </t>
                        
                        <a href="/event" class="btn btn-sm btn-outline-secondary mrbur-clear-btn">
                            Clear All
                        </a>
                    </div>
                </t>
                </div>
                <t t-if="not request.env.user._is_public()">
                    <div class="ms-auto ps-2 d-flex align-items-center gap-2">
                        <a href="/my/event/notifications" class="badge bg-light text-dark text-decoration-none position-relative">
                            <i class="fa fa-bell"></i>
                            Notifications
                            <span t-if="event_notification_count" class="badge rounded-pill bg-danger ms-1">
                                <t t-esc="event_notification_count"/>
                            </span>
                        </a>
                        <span class="badge bg-light text-dark">
                            <i class="fa fa-star"></i>
                            Points: <t t-esc="point_balance or 0"/>
                        </span>
                    </div>
                </t>
            </div>
        </xpath>
</template>

    <template id="event_page_specialty_case" inherit_id="website_event.event_description_full">
        <xpath expr="//aside[@id='o_wevent_event_main_sidebar']/div[@class='o_wevent_sidebar_block border-bottom pb-3 mb-4'][1]" position="after">
            <div t-if="event.specialty_ids or event.case_ids or event.specialty_other_text or event.case_other_text" class="o_wevent_sidebar_block border-bottom pb-3 mb-4">
                <t t-if="event.specialty_ids or event.specialty_other_text">
                    <h6 class="o_wevent_sidebar_title">Specialties</h6>
                    <div class="d-flex flex-wrap gap-2 mb-2">
                        <t t-foreach="event.specialty_ids" t-as="specialty">
                            <span class="badge text-bg-light mrbur-tag-badge"><t t-esc="specialty.name"/></span>
                        </t>
                        <t t-foreach="[name.strip() for name in (event.specialty_other_text or '').split(',') if name.strip()]" t-as="specialty_name">
                            <span class="badge text-bg-light mrbur-tag-badge"><t t-esc="specialty_name"/></span>
                        </t>
                    </div>
                </t>
                <t t-if="event.case_ids or event.case_other_text">
                    <h6 class="o_wevent_sidebar_title">Case Types</h6>
                    <div class="d-flex flex-wrap gap-2">
                        <t t-foreach="event.case_ids" t-as="case_item">
                            <span class="badge text-bg-light mrbur-tag-badge"><t t-esc="case_item.name"/></span>
                        </t>
                        <t t-foreach="[name.strip() for name in (event.case_other_text or '').split(',') if name.strip()]" t-as="case_name">
                            <span class="badge text-bg-light mrbur-tag-badge"><t t-esc="case_name"/></span>
                        </t>
                    </div>
                </t>
            </div>
        </xpath>
    </template>

    <template id="event_cards_description_toggle" inherit_id="website_event.events_list">
        <xpath expr="//div[contains(@class, 'o_wevent_card_description')]" position="replace">
            <div class="o_wevent_card_description text-muted mb-2" style="font-size: 0.875rem; line-height: 1.4;">
                <t t-if="event.description or event.subtitle">
                    <style>
                        .o_wevent_events_list article {
                            min-height: 520px;
                        }
                        .o_wevent_events_list article main {
                            min-height: 320px;
                            justify-content: flex-start !important;
                        }
                        .o_wevent_card_desc_preview {
                            max-height: 3.6em;
                            overflow: hidden;
                        }
                    </style>
                    <div class="o_wevent_card_desc_preview">
                        <t t-if="event.description">
                            <p t-field="event.description" class="mb-1 text-truncate" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"/>
                        </t>
                        <t t-if="not event.description">
                            <p t-field="event.subtitle" class="mb-1 text-truncate" style="display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;"/>
                        </t>
                    </div>
                </t>
            </div>
        </xpath>
    </template>

    <template id="event_cards_three_per_row" inherit_id="website_event.events_list">
        <xpath expr="//t[@t-if and @t-set='opt_event_size']" position="replace">
            <t t-set="opt_event_size" t-value="'col-12 col-md-4 col-lg-4 col-xl-4'"/>
        </xpath>
        <xpath expr="//t[@t-else and @t-set='opt_event_size']" position="replace">
            <t t-set="opt_event_size" t-value="'col-12 col-md-4 col-lg-4 col-xl-4'"/>
        </xpath>
    </template>

    <template id="event_cards_badge_overlay" inherit_id="website_event.events_list">
        <xpath expr="//t[@t-call='website.record_cover']/meta[@itemprop='startDate']" position="after">
            <t t-if="'card_bg_image' in event._fields and event.card_bg_image">
                <div class="o_wevent_card_bg"
                     t-attf-style="background-image: url(#{image_data_uri(event.card_bg_image)});"/>
            </t>
            <t t-if="'badge_image' in event._fields and event.badge_image">
                <img t-att-src="image_data_uri(event.badge_image)" alt="Badge" class="o_wevent_badge_overlay"/>
            </t>
        </xpath>
        <xpath expr="//t[@t-call='website.record_cover']" position="after">
            <style>
                .o_wevent_card_bg {
                    position: absolute;
                    inset: 0;
                    background-size: cover;
                    background-position: center;
                    z-index: 0;
                    pointer-events: none;
                }
                .o_wevent_card_bg ~ * {
                    position: relative;
                    z-index: 1;
                }
                .o_record_cover_container:has(.o_wevent_card_bg) .o_record_cover_image {
                    background-image: none !important;
                }
                .o_wevent_badge_overlay {
                    position: absolute;
                    top: 12px;
                    left: 12px;
                    max-height: 64px;
                    width: auto;
                    filter: drop-shadow(0 2px 6px rgba(0,0,0,0.25));
                    border-radius: 6px;
                }
            </style>
        </xpath>
    </template>

    <!-- Make event info sidebar sticky and allow overflow for sticky on register/description pages -->
    <template id="event_sidebar_sticky" inherit_id="website_event.event_description_full">
        <!-- Allow sticky positioning by removing overflow hidden on main container -->
        <xpath expr="//section[@id='o_wevent_event_main']/div[contains(@class,'container')]" position="attributes">
            <attribute name="class">container pb-5</attribute>
            <attribute name="style">overflow: visible;</attribute>
        </xpath>
        <!-- Stick the sidebar on the right -->
        <xpath expr="//aside[@id='o_wevent_event_main_sidebar']" position="attributes">
            <attribute name="style">position: sticky; top: 1.5rem;</attribute>
        </xpath>
        <xpath expr="//section[@id='o_wevent_event_main']" position="inside">
            <style>
                /* ensure no ancestor blocks sticky */
                #o_wevent_event_main .container { overflow: visible !important; }
            </style>
        </xpath>
    </template>

    <!-- Add image carousel gallery to the register page -->
    <template id="event_register_gallery" inherit_id="website_event.event_description_full">
        <xpath expr="//div[@id='o_wevent_event_main_col']" position="before">
            <t t-set="reg_carousel_id" t-value="'eaRegCarousel-%s' % event.id"/>
            <div class="card border-0 shadow-sm mb-4">
                <div class="carousel slide" t-att-id="reg_carousel_id" data-bs-ride="carousel" data-bs-interval="8000">
                    <div class="carousel-inner">
                        <t t-set="gallery" t-value="event.image_ids"/>
                        <t t-if="gallery">
                            <t t-foreach="gallery" t-as="img_rec" t-key="img_rec.id">
                                <div t-attf-class="carousel-item #{'active' if img_rec == gallery[:1][0] else ''}">
                                    <img t-att-src="image_data_uri(img_rec.image)" class="d-block w-100" style="max-height:420px;object-fit:cover;" t-att-alt="img_rec.name or 'Event image'"/>
                                </div>
                            </t>
                        </t>
                        <t t-elif="'thumbnail_image' in event._fields and event.thumbnail_image">
                            <div class="carousel-item active">
                                <img t-att-src="image_data_uri(event.thumbnail_image)" class="d-block w-100" style="max-height:420px;object-fit:cover;" alt="Event image"/>
                            </div>
                        </t>
                        <t t-elif="'badge_image' in event._fields and event.badge_image">
                            <div class="carousel-item active">
                                <img t-att-src="image_data_uri(event.badge_image)" class="d-block w-100" style="max-height:420px;object-fit:cover;" alt="Event image"/>
                            </div>
                        </t>
                        <t t-else="">
                            <div class="carousel-item active">
                                <img src="data:image/jpg;base64,"}} alt="Event image fallback"/>
                            </div>
                        </t>
                    </div>
                    <button class="carousel-control-prev" type="button" t-att-data-bs-target="'#%s' % reg_carousel_id" data-bs-slide="prev">
                        <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Previous</span>
                    </button>
                    <button class="carousel-control-next" type="button" t-att-data-bs-target="'#%s' % reg_carousel_id" data-bs-slide="next">
                        <span class="carousel-control-next-icon" aria-hidden="true"></span>
                        <span class="visually-hidden">Next</span>
                    </button>
                </div>
            </div>
        </xpath>
    </template>

    <template id="event_cards_safe_venue_fields" inherit_id="website_event.events_list">
        <xpath expr="//t[@t-set='has_venue_address']" position="replace">
            <t t-set="has_venue_address"
               t-value="('venue_address' in event._fields and event.venue_address) or ('venue_city' in event._fields and event.venue_city) or ('venue_country_id' in event._fields and event.venue_country_id) or ('location' in event._fields and event.location) or event.address_id"/>
        </xpath>
        <xpath expr="//main//div[contains(@class, 'd-flex') and contains(@class, 'align-items-center')][i[contains(@class, 'fa-map-marker')]]" position="replace">
            <div class="d-flex align-items-center">
                <i class="fa fa-map-marker me-2" title="Location"/>
                <small t-if="has_venue_address"
                       class="fw-bold"
                       itemprop="location"
                       t-out="(('venue_full_address' in event._fields and event.venue_full_address) or ('location' in event._fields and event.location) or (event.address_id and (event.address_id.contact_address or event.address_id.name)) or 'Venue')"/>
                <small t-if="not has_venue_address" class="fw-bold" itemprop="location">Online event</small>
            </div>
        </xpath>
    </template>

    <!-- Use the event's stored image as the main cover background instead of the static default -->
    <template id="event_cover_use_event_image" inherit_id="website_event.event_description_full">
        <!-- Inject styles inside the main template to drive the cover background -->
        <xpath expr="//t[@t-call='website_event.event_details']" position="inside">
            <t t-if="event">
                <t t-if="'card_bg_image' in event._fields and event.card_bg_image">
                    <style>
                        /* Use custom card background image when provided */
                        .o_wevent_event_main_cover .o_record_cover_image {
                            background-image: url("<t t-esc='image_data_uri(event.card_bg_image)'/>") !important;
                            background-size: cover !important;
                            background-position: center center !important;
                        }
                    </style>
                </t>
                <t t-elif="'badge_image' in event._fields and event.badge_image">
                    <style>
                        /* Fallback to badge image if provided */
                        .o_wevent_event_main_cover .o_record_cover_image {
                            background-image: url("<t t-esc='image_data_uri(event.badge_image)'/>") !important;
                            background-size: cover !important;
                            background-position: center center !important;
                        }
                    </style>
                </t>
                <t t-elif="'image' in event._fields">
                    <style>
                        .o_wevent_event_main_cover .o_record_cover_image {
                            background-image: url("/web/image/event.event/<t t-esc='event.id'/>/image") !important;
                            background-size: cover !important;
                            background-position: center center !important;
                        }
                    </style>
                </t>
            </t>
        </xpath>
    </template>

    <!-- Show the uploaded event image/thumbnail in the event header -->
    <template id="event_cover_show_thumb" inherit_id="website_event.event_description_full">
        <!-- Cover at top variant -->
        <xpath expr="//t[@t-if='opt_event_description_cover_top']//div[@id='o_wevent_event_main_cover_content']//div[@class='w-100 mt-auto']" position="inside">
            <t t-if="'image_512' in event._fields">
                <img t-att-src="'/web/image/event.event/%s/image_512' % event.id"
                     alt="Event image"
                     class="o_wevent_cover_thumb mb-2 rounded shadow-sm"
                     style="max-height: 180px; width: auto;"/>
            </t>
        </xpath>
        <!-- Cover within main body variant -->
        <xpath expr="//t[@t-if='not opt_event_description_cover_top' and @t-call='website.record_cover']//div[@id='o_wevent_event_main_cover_content']" position="inside">
            <t t-if="'image_512' in event._fields">
                <img t-att-src="'/web/image/event.event/%s/image_512' % event.id"
                     alt="Event image"
                     class="o_wevent_cover_thumb mb-2 rounded shadow-sm"
                     style="max-height: 180px; width: auto;"/>
            </t>
        </xpath>
    </template>

    <template id="event_icon_and_gallery" inherit_id="website_event.event_description_full">
        <!-- Image gallery below the description (attached inside the main event container for robustness across template variants) -->
        <xpath expr="//section[@id='o_wevent_event_main']" position="inside">
            <t t-if="event.image_ids">
                <!-- Gallery intentionally suppressed; handled by custom two-column hero below -->
            </t>
        </xpath>

        <xpath expr="//section[@id='o_wevent_event_main']" position="after">
            <style>
                .ea-gallery-card .card-body {
                    background: #f8fafc;
                }
                .ea-gallery-thumb {
                    position: relative;
                    border-radius: 12px;
                    overflow: hidden;
                    box-shadow: 0 8px 18px rgba(35, 83, 163, 0.14);
                    background: #fff;
                }
                .ea-gallery-thumb img {
                    width: 100%;
                    height: 180px;
                    object-fit: cover;
                    display: block;
                }
                .ea-gallery-badge {
                    position: absolute;
                    top: 10px;
                    left: 10px;
                    border-radius: 999px;
                }
            </style>
        </xpath>
    </template>


    <template id="registration_complete_my_registrations" inherit_id="website_event.registration_complete">
        <xpath expr="//div[contains(@class, 'o_wereg_confirmed')]//div[@class='row mb-3']/div[@class='col-12']" position="inside">
            <div class="mt-2">
                <a href="/my/events/registrations" class="btn btn-primary">
                    <i class="fa fa-qrcode"></i> My Registrations
                </a>
            </div>
        </xpath>
    </template>

    <template id="registration_attendee_details_simple" inherit_id="website_event.registration_attendee_details">
        <xpath expr="//form[@id='attendee_registration']" position="replace">
            <form id="attendee_registration" t-attf-action="/event/#{slug(event)}/registration/payment" method="post" class="js_website_submit_form">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <div class="modal-content">
                    <div class="modal-header align-items-center">
                        <h4 class="modal-title">Attendees</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"/>
                    </div>
                    <t t-set="counter" t-value="0"/>
                    <t t-if="availability_check">
                        <t t-set="total_points_needed" t-value="0"/>
                        <t t-foreach="tickets" t-as="ticket_for_points">
                            <t t-set="total_points_needed" t-value="total_points_needed + ((ticket_for_points.get('point_cost') or 0) * (ticket_for_points.get('quantity') or 0))"/>
                        </t>
                        <div class="modal-body border-bottom">
                            <h5 class="mt-1 pb-2 border-bottom">Where should we send the tickets?</h5>
                            <div class="alert alert-info py-2 px-3 mb-3 d-flex align-items-center gap-2">
                                <i class="fa fa-clone"></i>
                                <span>Use the + / - controls below to choose multiple tickets per type.</span>
                            </div>
                            <div class="row">
                                <div class="col-lg-6 mt-2">
                                    <label class="form-label">Name</label>
                                    <input class="form-control" type="text" name="buyer_name"
                                           t-att-value="default_first_attendee.get('name', '')" required="required"/>
                                </div>
                                <div class="col-lg-6 mt-2">
                                    <label class="form-label">Email</label>
                                    <input class="form-control" type="email" name="buyer_email"
                                           t-att-value="default_first_attendee.get('email', '')" required="required"/>
                                </div>
                                <div class="col-lg-6 mt-2">
                                    <label class="form-label">Phone</label>
                                    <input class="form-control" type="tel" name="buyer_phone"
                                           t-att-value="default_first_attendee.get('phone', '')"/>
                                </div>
                            </div>
                            <div class="alert alert-info mt-3 mb-0" t-if="total_points_needed">
                                <strong>Points Needed:</strong>
                                <span t-esc="total_points_needed"/> points for this registration.
                            </div>
                        </div>
                        <t t-foreach="tickets" t-as="ticket">
                            <t t-foreach="range(1, ticket['quantity'] + 1)" t-as="att_counter" name="attendee_loop">
                                <t t-set="counter" t-value="counter + 1"/>
                                <div class="modal-body">
                                    <h5 t-attf-class="mt-1 pb-2 #{'border-bottom' if event.question_ids else ''}">
                                        Ticket #<span t-out="counter"/>
                                        <small class="text-muted">- <span t-out="ticket['name']"/></small>
                                        <small class="text-muted" t-if="ticket.get('point_cost')">
                                            (<span t-out="ticket.get('point_cost')"/> points)
                                        </small>
                                    </h5>
                                    <div class="row">
                                        <div class="col-lg-6 mt-2">
                                            <label class="form-label">Ticket holder name</label>
                                            <input class="form-control" type="text" t-attf-name="ticket_name-#{counter}" required="required"/>
                                        </div>
                                    </div>
                                    <input class="d-none" type="text" t-attf-name="#{counter}-event_ticket_id" t-attf-value="#{ticket['id']}"/>
                                </div>
                            </t>
                        </t>
                    </t>
                    <t t-else="">
                        <div class="modal-body border-bottom">
                            <strong> You ordered more tickets than available seats</strong>
                        </div>
                    </t>
                    <div class="modal-footer border-top">
                        <button type="button" class="btn btn-secondary js_goto_event" data-bs-dismiss="modal">Cancel</button>
                        <button type="submit" class="btn btn-primary" t-if="availability_check">Continue to Payment</button>
                    </div>
                </div>
            </form>
        </xpath>
    </template>

    <template id="registration_template_insufficient_points" inherit_id="website_event.registration_template">
        <xpath expr="//div[@t-if=&quot;registration_error_code == 'insufficient_seats'&quot;]" position="replace">
            <div t-if="registration_error_code in ('insufficient_seats', 'insufficient_points')" class="alert alert-danger my-3" role="alert">
                <t t-if="registration_error_code == 'insufficient_seats'">
                    Registration failed! These tickets are not available anymore.
                </t>
                <t t-elif="registration_error_code == 'insufficient_points'">
                    Insufficient points.
                    <t t-if="request.params.get('required_points') and request.params.get('available_points')">
                        Required:
                        <strong><t t-esc="request.params.get('required_points')"/></strong>,
                        Available:
                        <strong><t t-esc="request.params.get('available_points')"/></strong>.
                    </t>
                </t>
            </div>
        </xpath>
    </template>

    <template id="modal_ticket_registration_insufficient_points" inherit_id="website_event.modal_ticket_registration">
        <xpath expr="//div[@t-if=&quot;registration_error_code == 'insufficient_seats'&quot;]" position="replace">
            <div t-if="registration_error_code in ('insufficient_seats', 'insufficient_points')" class="alert alert-danger" role="alert">
                <p class="mb-0" t-if="registration_error_code == 'insufficient_seats'">
                    Registration failed! These tickets are not available anymore.
                </p>
                <p class="mb-0" t-elif="registration_error_code == 'insufficient_points'">
                    Insufficient points.
                    <t t-if="request.params.get('required_points') and request.params.get('available_points')">
                        Required:
                        <strong><t t-esc="request.params.get('required_points')"/></strong>,
                        Available:
                        <strong><t t-esc="request.params.get('available_points')"/></strong>.
                    </t>
                </p>
            </div>
        </xpath>
    </template>

    <template id="event_description_full_insufficient_points_banner" inherit_id="website_event.event_description_full">
        <xpath expr="//section[@id='o_wevent_event_main']/div[contains(@class, 'container')]" position="inside">
            <div t-if="registration_error_code == 'insufficient_points'" class="alert alert-danger my-3" role="alert">
                Insufficient points to complete registration.
                <t t-if="request.params.get('required_points') and request.params.get('available_points')">
                    Required:
                    <strong><t t-esc="request.params.get('required_points')"/></strong>,
                    Available:
                    <strong><t t-esc="request.params.get('available_points')"/></strong>.
                </t>
            </div>
        </xpath>
    </template>

    <template id="modal_ticket_registration_quantity_plus_minus_multi" inherit_id="website_event.modal_ticket_registration">
        <xpath expr="//select[contains(@t-attf-name, 'nb_register-')]" position="replace">
            <t t-if="not ticket.is_expired and ticket.sale_available">
                <t t-set="seats_max_ticket" t-value="(not ticket.seats_limited or ticket.seats_available &gt; 9) and 10 or ticket.seats_available + 1"/>
                <t t-set="seats_max_event" t-value="(not event.seats_limited or event.seats_available &gt; 9) and 10 or event.seats_available + 1"/>
                <t t-set="seats_max" t-value="min(seats_max_ticket, seats_max_event)"/>
                <div class="ea-qty-control d-inline-flex align-items-center gap-1">
                    <button type="button" class="btn btn-outline-secondary ea-qty-minus" aria-label="Decrease">-</button>
                    <input type="number" class="form-control ea-qty-input text-center" value="0" min="0" t-att-max="seats_max - 1" style="width: 72px;"/>
                    <button type="button" class="btn btn-outline-secondary ea-qty-plus" aria-label="Increase">+</button>
                    <select t-attf-name="nb_register-#{ticket.id}" class="form-select d-none ea-qty-select">
                        <t t-foreach="range(0, seats_max)" t-as="nb">
                            <option t-out="nb" t-att-selected="len(ticket) == 0 and nb == 0 and 'selected'"/>
                        </t>
                    </select>
                </div>
            </t>
        </xpath>
    </template>

    <template id="modal_ticket_registration_quantity_plus_minus_single" inherit_id="website_event.modal_ticket_registration">
        <xpath expr="//select[contains(@t-att-name, 'nb_register-')]" position="replace">
            <t t-set="seats_max_ticket" t-value="(not tickets or not tickets.seats_limited or tickets.seats_available &gt; 9) and 10 or tickets.seats_available + 1"/>
            <t t-set="seats_max_event" t-value="(not event.seats_limited or event.seats_available &gt; 9) and 10 or event.seats_available + 1"/>
            <t t-set="seats_max" t-value="min(seats_max_ticket, seats_max_event) if tickets else seats_max_event"/>
            <div class="ea-qty-control d-inline-flex align-items-center gap-1 ms-auto">
                <button type="button" class="btn btn-outline-secondary ea-qty-minus" aria-label="Decrease">-</button>
                <input type="number" class="form-control ea-qty-input text-center" value="1" min="0" t-att-max="seats_max - 1" style="width: 72px;"/>
                <button type="button" class="btn btn-outline-secondary ea-qty-plus" aria-label="Increase">+</button>
                <select t-att-name="'nb_register-%s' % (tickets.id if tickets else 0)" class="form-select d-none ea-qty-select">
                    <t t-foreach="range(0, seats_max)" t-as="nb">
                        <option t-out="nb" t-att-selected="nb == 1 and 'selected'"/>
                    </t>
                </select>
            </div>
        </xpath>
        <xpath expr="//form[@id='registration_form']" position="after">
            <style>
                .ea-qty-control .btn {
                    min-width: 34px;
                    padding: 0.25rem 0.5rem;
                    line-height: 1.2;
                }
                .ea-qty-input {
                    min-height: 34px;
                }
            </style>
            <script>
                <![CDATA[
                document.addEventListener('click', function (ev) {
                    const minusBtn = ev.target.closest('.ea-qty-minus');
                    const plusBtn = ev.target.closest('.ea-qty-plus');
                    if (!minusBtn && !plusBtn) {
                        return;
                    }
                    ev.preventDefault();
                    const control = (minusBtn || plusBtn).closest('.ea-qty-control');
                    if (!control) {
                        return;
                    }
                    const input = control.querySelector('.ea-qty-input');
                    const select = control.querySelector('.ea-qty-select');
                    if (!input || !select) {
                        return;
                    }
                    const min = parseInt(input.min || '0', 10);
                    const max = parseInt(input.max || '0', 10);
                    let value = parseInt(input.value || '0', 10);
                    if (Number.isNaN(value)) {
                        value = min;
                    }
                    if (minusBtn) {
                        value = Math.max(min, value - 1);
                    } else {
                        value = Math.min(max, value + 1);
                    }
                    input.value = String(value);
                    select.value = String(value);
                    select.dispatchEvent(new Event('change', { bubbles: true }));
                });

                document.addEventListener('input', function (ev) {
                    const input = ev.target.closest('.ea-qty-input');
                    if (!input) {
                        return;
                    }
                    const control = input.closest('.ea-qty-control');
                    const select = control ? control.querySelector('.ea-qty-select') : null;
                    if (!select) {
                        return;
                    }
                    const min = parseInt(input.min || '0', 10);
                    const max = parseInt(input.max || '0', 10);
                    let value = parseInt(input.value || '0', 10);
                    if (Number.isNaN(value)) {
                        value = min;
                    }
                    value = Math.max(min, Math.min(max, value));
                    input.value = String(value);
                    select.value = String(value);
                    select.dispatchEvent(new Event('change', { bubbles: true }));
                });
                ]]>
            </script>
        </xpath>
    </template>

    <template id="registration_payment_page" name="Registration Payment Page">
        <t t-call="website.layout">
            <div class="container my-5">
                <div class="row justify-content-center">
                    <div class="col-lg-9">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <h3 class="mb-0">Payment Review</h3>
                            <a t-attf-href="/event/#{slug(event)}/register" class="btn btn-outline-secondary">Back to Tickets</a>
                        </div>

                        <div class="card mb-3">
                            <div class="card-body">
                                <h5 class="card-title mb-3"><t t-esc="event.name"/></h5>
                                <div class="row">
                                    <div class="col-md-4"><strong>Buyer</strong><br/><t t-esc="buyer_name"/></div>
                                    <div class="col-md-4"><strong>Email</strong><br/><t t-esc="buyer_email"/></div>
                                    <div class="col-md-4"><strong>Phone</strong><br/><t t-esc="buyer_phone or '-'"/></div>
                                </div>
                            </div>
                        </div>

                        <div class="alert alert-danger" t-if="payment_error_code == 'insufficient_points'">
                            Insufficient points.
                            <t t-if="required_points and available_points">
                                Required: <strong><t t-esc="required_points"/></strong>,
                                Available: <strong><t t-esc="available_points"/></strong>.
                            </t>
                        </div>

                        <div class="card">
                            <div class="card-header">
                                <strong>Invoice</strong>
                            </div>
                            <div class="card-body p-0">
                                <div class="table-responsive">
                                    <table class="table mb-0">
                                        <thead>
                                            <tr>
                                                <th>Ticket</th>
                                                <th class="text-end">Qty</th>
                                                <th class="text-end">Unit Amount</th>
                                                <th class="text-end">Unit Points</th>
                                                <th class="text-end">Line Amount</th>
                                                <th class="text-end">Line Points</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr t-foreach="invoice_lines" t-as="line">
                                                <td><t t-esc="line['name']"/></td>
                                                <td class="text-end"><t t-esc="line['qty']"/></td>
                                                <td class="text-end"><t t-esc="'%.2f' % (line['unit_amount'])"/></td>
                                                <td class="text-end"><t t-esc="line['unit_points']"/></td>
                                                <td class="text-end"><t t-esc="'%.2f' % (line['line_amount'])"/></td>
                                                <td class="text-end"><t t-esc="line['line_points']"/></td>
                                            </tr>
                                            <tr t-if="not invoice_lines">
                                                <td colspan="6" class="text-center text-muted py-3">No ticket lines found.</td>
                                            </tr>
                                        </tbody>
                                        <tfoot>
                                            <tr>
                                                <th colspan="4" class="text-end">Total</th>
                                                <th class="text-end"><t t-esc="'%.2f' % (total_amount or 0.0)"/></th>
                                                <th class="text-end"><t t-esc="total_points or 0"/></th>
                                            </tr>
                                        </tfoot>
                                    </table>
                                </div>
                            </div>
                            <div class="card-footer d-flex justify-content-end gap-2">
                                <a t-attf-href="/event/#{slug(event)}/register" class="btn btn-secondary">Cancel</a>
                                <form t-attf-action="/event/#{slug(event)}/registration/confirm-payment" method="post" class="d-inline">
                                    <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                                    <button type="submit" class="btn btn-primary">Complete Payment &amp; Book Tickets</button>
                                </form>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </t>
    </template>

    <!-- Two-column hero: left image carousel, right details and tickets -->
    <template id="event_two_column_showcase" inherit_id="website_event.event_description_full">
        <!-- Remove default long description block so we only show the hero description once -->
        <xpath expr="//div[@id='o_wevent_event_main_col']/div[@class='mt-4' and @itemprop='description']" position="replace">
            <t/>
        </xpath>
        <xpath expr="//section[@id='o_wevent_event_main']/div[contains(@class,'container')]" position="inside">
            <style>
                .ea-hero-card {
                    border: 1px solid #c4d1e6;
                    border-radius: 14px;
                    box-shadow: 0 10px 28px rgba(35,83,163,0.12);
                    overflow: hidden;
                    background: #fff;
                }
                .ea-hero-left img {
                    width: 100%;
                    height: 360px;
                    object-fit: cover;
                }
                @media (min-width: 992px) {
                    .ea-hero-left img { height: 420px; }
                }
                .ea-hero-right h2 { margin-bottom: .35rem; }
                .ea-ticket-pill {
                    border: 1px solid #d7deee;
                    border-radius: 10px;
                    padding: .4rem .65rem;
                    background: #f6f8fc;
                    font-size: .9rem;
                }
                /* Keep the info column visible on the right while scrolling */
                #o_wevent_event_main_sidebar {
                    position: sticky;
                    top: 1.5rem;
                }
            </style>
            <div class="ea-hero-card row g-0 mb-4">
                <div class="col-lg-6 ea-hero-left">
                    <t t-set="carousel_id" t-value="'eaCarousel-%s' % event.id"/>
                    <div t-att-id="carousel_id" class="carousel slide" data-bs-ride="carousel" data-bs-interval="10000">
                        <div class="carousel-inner">
                            <t t-set="gallery" t-value="event.image_ids"/>
                            <t t-if="gallery">
                                <t t-foreach="gallery" t-as="img_rec" t-key="img_rec.id">
                                    <div t-attf-class="carousel-item #{'active' if img_rec == gallery[:1][0] else ''}">
                                        <img t-att-src="image_data_uri(img_rec.image)" t-att-alt="img_rec.name or 'Event image'"/>
                                    </div>
                                </t>
                            </t>
                            <t t-elif="'thumbnail_image' in event._fields and event.thumbnail_image">
                                <div class="carousel-item active">
                                    <img t-att-src="image_data_uri(event.thumbnail_image)" alt="Event image"/>
                                </div>
                            </t>
                            <t t-elif="'badge_image' in event._fields and event.badge_image">
                                <div class="carousel-item active">
                                    <img t-att-src="image_data_uri(event.badge_image)" alt="Event image"/>
                                </div>
                            </t>
                        </div>
                        <button class="carousel-control-prev" type="button" t-att-data-bs-target="'#%s' % carousel_id" data-bs-slide="prev">
                            <span class="carousel-control-prev-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Previous</span>
                        </button>
                        <button class="carousel-control-next" type="button" t-att-data-bs-target="'#%s' % carousel_id" data-bs-slide="next">
                            <span class="carousel-control-next-icon" aria-hidden="true"></span>
                            <span class="visually-hidden">Next</span>
                        </button>
                    </div>
                </div>
                <div class="col-lg-6 p-4 p-lg-5 ea-hero-right">
                    <h2 class="fw-bold"><t t-esc="event.name"/></h2>
                    <div class="text-muted mb-2">
                        <i class="fa fa-calendar me-1"></i>
                        <t t-esc="event.date_begin" t-options="{'widget':'datetime'}"/>
                        <t t-if="event.date_end"> – <t t-esc="event.date_end" t-options="{'widget':'datetime'}"/></t>
                    </div>
                    <div class="text-muted mb-3">
                        <i class="fa fa-map-marker me-1"></i>
                        <t t-esc="event.full_address or event.location or event.address_id.name or 'Online / TBD'"/>
                    </div>
                    <div class="mb-3">
                        <t t-if="event.specialty_ids">
                            <span class="badge bg-light text-dark me-1 mb-1" t-foreach="event.specialty_ids" t-as="spec" t-key="spec.id">
                                <t t-esc="spec.name"/>
                            </span>
                        </t>
                        <t t-if="event.case_ids">
                            <span class="badge bg-light text-dark me-1 mb-1" t-foreach="event.case_ids" t-as="case_item" t-key="case_item.id">
                                <t t-esc="case_item.name"/>
                            </span>
                        </t>
                    </div>
                    <div class="mb-3">
                        <p class="text-secondary ea-desc-truncate" data-max-words="80" t-if="event.description">
                            <t t-raw="event.description"/>
                        </p>
                    </div>
                    <div class="d-flex flex-wrap gap-2 align-items-center mb-3">
                        <t t-foreach="event.event_ticket_ids" t-as="ticket" t-key="ticket.id">
                            <div class="ea-ticket-pill">
                                <strong><t t-esc="ticket.name"/></strong>
                                <t t-if="ticket.seats_limited">
                                    · <t t-esc="(ticket.seats_available or 0)"/> left
                                </t>
                                <t t-if="'point_cost' in ticket._fields and ticket.point_cost">
                                    · <t t-esc="ticket.point_cost"/> pts
                                </t>
                            </div>
                        </t>
                        <t t-if="not event.event_ticket_ids">
                            <span class="text-muted">No tickets configured.</span>
                        </t>
                    </div>
                    <div class="d-flex gap-2">
                        <a t-attf-href="/event/#{slug(event)}/register" class="btn btn-primary">Get Tickets</a>
                        <a t-attf-href="/event/#{slug(event)}" class="btn btn-outline-secondary">Details</a>
                    </div>
                </div>
            </div>
        </xpath>
    </template>

</odoo>



