<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="event_event_kanban_inherit_delete" model="ir.ui.view">
        <field name="name">event.event.kanban.delete.button</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_kanban"/>
        <field name="arch" type="xml">
            <xpath expr="//kanban" position="inside">
                <field name="website_published"/>
                <field name="is_published"/>
                <field name="active"/>
                <style>
                    .o_event_kanban_view .ea-event-card--published {
                        background: linear-gradient(135deg, #eef8f1 0%, #ffffff 100%);
                        border-left: 4px solid #2e8b57;
                    }
                    .o_event_kanban_view .ea-event-card--hidden {
                        background: linear-gradient(135deg, #f5f6f8 0%, #ffffff 100%);
                        border-left: 4px solid #6c757d;
                    }
                    .o_event_kanban_view .ea-event-card--archived {
                        background: linear-gradient(135deg, #fff7e8 0%, #ffffff 100%);
                        border-left: 4px solid #c98a00;
                    }
                    .o_event_kanban_view .ea-event-visibility-badge {
                        font-size: 0.72rem;
                        font-weight: 600;
                        border-radius: 999px;
                        padding: 0.15rem 0.5rem;
                        white-space: nowrap;
                    }
                    .o_event_kanban_view .ea-event-visibility-badge--published {
                        background: #dff3e4;
                        color: #20613d;
                    }
                    .o_event_kanban_view .ea-event-visibility-badge--hidden {
                        background: #e9ecef;
                        color: #495057;
                    }
                    .o_event_kanban_view .ea-event-visibility-badge--archived {
                        background: #fff1cf;
                        color: #8a5a00;
                    }
                </style>
            </xpath>

            <xpath expr="//main" position="attributes">
                <attribute name="t-attf-class">col pt-3 pb-2 px-3 justify-content-between #{'ea-event-card--archived' if not record.active.raw_value else 'ea-event-card--published' if record.website_published.raw_value else 'ea-event-card--hidden'}</attribute>
            </xpath>

            <xpath expr="//main/div/div[contains(@class, 'd-flex') and contains(@class, 'align-items-start') and contains(@class, 'gap-2')]" position="replace">
                <div class="d-flex align-items-start gap-2" style="min-width: 0;">
                    <div class="fw-bold fs-5 o_text_overflow flex-grow-1"
                         style="min-width: 0; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;"
                         t-att-title="record.name.value">
                        <field name="name"/>
                    </div>
                    <button t-if="record.active.raw_value and record.website_published.raw_value"
                            name="website_publish_button"
                            type="object"
                            class="btn btn-sm btn-link text-success p-0 oe_kanban_action"
                            title="Visible to users">
                        <i class="fa fa-eye" aria-label="Visible"/>
                    </button>
                    <button t-elif="record.active.raw_value"
                            name="website_publish_button"
                            type="object"
                            class="btn btn-sm btn-link text-secondary p-0 oe_kanban_action"
                            title="Hidden from users">
                        <i class="fa fa-eye-slash" aria-label="Hidden"/>
                    </button>
                    <button t-if="record.active.raw_value"
                            name="action_archive"
                            type="object"
                            class="btn btn-sm btn-link text-warning p-0 oe_kanban_action"
                            title="Archive"
                            confirm="Archive this event and hide it from the public event page?">
                        <i class="fa fa-archive" aria-label="Archive"/>
                    </button>
                    <button t-else=""
                            name="action_unarchive"
                            type="object"
                            class="btn btn-sm btn-link text-success p-0 oe_kanban_action"
                            title="Restore">
                        <i class="fa fa-undo" aria-label="Restore"/>
                    </button>
                </div>
            </xpath>

            <xpath expr="//main/div/div[contains(@class, 'd-flex') and contains(@class, 'ps-1')][1]" position="before">
                <div class="d-flex ps-1 mb-1">
                    <span t-if="not record.active.raw_value" class="ea-event-visibility-badge ea-event-visibility-badge--archived">
                        Archived
                    </span>
                    <span t-elif="record.website_published.raw_value" class="ea-event-visibility-badge ea-event-visibility-badge--published">
                        Published
                    </span>
                    <span t-else="" class="ea-event-visibility-badge ea-event-visibility-badge--hidden">
                        Hidden
                    </span>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
