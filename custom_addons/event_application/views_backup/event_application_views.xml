<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- ================= Access Rights ================= -->
        <record id="access_event_application_user" model="ir.model.access">
            <field name="name">event.application.user</field>
            <field name="model_id" ref="model_event_application"/>
            <field name="group_id" ref="base.group_portal"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="access_event_application_public" model="ir.model.access">
            <field name="name">event.application.public</field>
            <field name="model_id" ref="model_event_application"/>
            <field name="group_id" ref="base.group_public"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="access_event_application_manager" model="ir.model.access">
            <field name="name">event.application.manager</field>
            <field name="model_id" ref="model_event_application"/>
            <field name="group_id" ref="base.group_system"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <record id="access_event_event_portal" model="ir.model.access">
            <field name="name">event.event.portal</field>
            <field name="model_id" ref="event.model_event_event"/>
            <field name="group_id" ref="base.group_portal"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="access_event_registration_portal" model="ir.model.access">
            <field name="name">event.registration.portal</field>
            <field name="model_id" ref="event.model_event_registration"/>
            <field name="group_id" ref="base.group_portal"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- ================= Tree View ================= -->
        <record id="view_event_application_tree" model="ir.ui.view">
            <field name="name">event.application.tree</field>
            <field name="model">event.application</field>
            <field name="arch" type="xml">
                <tree string="Event Applications" 
                      decoration-info="state=='submitted'" 
                      decoration-success="state in ('approved','published')" 
                      decoration-danger="state=='rejected'"
                      decoration-muted="state=='draft'">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="date_begin"/>
                    <field name="date_end"/>
                    <field name="venue_type"/>
                    <field name="venue_name"/>
                    <field name="full_address"/>
                    <field name="address_input" optional="hide"/>
                    <field name="state" widget="badge"/>
                </tree>
            </field>
        </record>

        <!-- ================= Search View ================= -->
        <record id="view_event_application_search" model="ir.ui.view">
            <field name="name">event.application.search</field>
            <field name="model">event.application</field>
            <field name="arch" type="xml">
                <search string="Event Applications">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="venue_name"/>
                    <field name="city"/>
                    <field name="location"/>
                    <separator/>
                    <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                    <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                    <filter string="Published" name="published" domain="[('state','=','published')]"/>
                    <filter string="Rejected" name="rejected" domain="[('state','=','rejected')]"/>
                    <filter string="Physical Events" name="physical" domain="[('venue_type','=','physical')]"/>
                    <filter string="Online Events" name="online" domain="[('venue_type','=','online')]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                        <filter string="Organizer" name="group_partner" context="{'group_by':'partner_id'}"/>
                        <filter string="Venue Type" name="group_venue_type" context="{'group_by':'venue_type'}"/>
                        <filter string="City" name="group_city" context="{'group_by':'city'}"/>
                        <filter string="Start Date" name="group_date_begin" context="{'group_by':'date_begin'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- ================= Form View ================= -->
        <record id="view_event_application_form" model="ir.ui.view">
            <field name="name">event.application.form</field>
            <field name="model">event.application</field>
            <field name="arch" type="xml">
                <form string="Event Application">
                    <header>
                        <button name="action_submit" string="Submit" type="object" 
                                invisible="state != 'draft'" 
                                class="btn-primary"/>
                        <button name="action_approve" string="Approve" type="object" 
                                invisible="state != 'submitted'" 
                                class="btn-success" 
                                groups="base.group_system"/>
                        <button name="action_reject" string="Reject" type="object" 
                                invisible="state != 'submitted'" 
                                class="btn-danger" 
                                groups="base.group_system"/>
                        <button name="action_publish" string="Publish as Event" type="object" 
                                invisible="state != 'approved'" 
                                class="btn-primary" 
                                groups="base.group_system"
                                confirm="This will create a public event on your website. Continue?"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object" 
                                invisible="state not in ('rejected','submitted')" 
                                groups="base.group_system"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,published"/>
                    </header>
                    <sheet>
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="partner_id"/>
                                <field name="venue_type"/>
                                <field name="venue_name"/>
                                <field name="city"/>
                                <field name="online_platform"/>
                                <field name="online_link"/>
                            </group>
                            <group>
                                <field name="date_begin"/>
                                <field name="date_end"/>
                                <field name="registration_start"/>
                                <field name="registration_end"/>
                                <field name="registration_limit"/>
                                <field name="max_registrations" invisible="not registration_limit"/>
                                <field name="badge_image" widget="image"/>
                                <field name="card_bg_image" widget="image"/>
                                <field name="event_id" readonly="1" invisible="not event_id"/>
                            </group>
                        </group>
                        <notebook>
                            <page string="Description">
                                <field name="description" widget="html"/>
                            </page>
                            <page string="Admin Notes" groups="base.group_system">
                                <group>
                                    <field name="rejection_reason" invisible="state != 'rejected'"/>
                                </group>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- ================= Kanban View ================= -->
        <record id="view_event_application_kanban" model="ir.ui.view">
            <field name="name">event.application.kanban</field>
            <field name="model">event.application</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="date_begin"/>
                    <field name="venue_type"/>
                    <field name="venue_name"/>
                    <field name="city"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_top">
                                    <div class="o_kanban_record_headings">
                                        <strong class="o_kanban_record_title"><field name="name"/></strong>
                                    </div>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="partner_id"/>
                                    <br/>
                                    <i class="fa fa-calendar" title="Start Date" aria-label="Start Date"/> <field name="date_begin" widget="date"/>
                                    <br/>
                                    <t t-if="record.venue_type.raw_value == 'physical'">
                                        <i class="fa fa-map-marker" title="Venue" aria-label="Venue"/> <field name="venue_name"/>
                                        <t t-if="record.city.raw_value">
                                            , <field name="city"/>
                                        </t>
                                    </t>
                                    <t t-if="record.venue_type.raw_value == 'online'">
                                        <i class="fa fa-globe" title="Online Event" aria-label="Online Event"/> Online Event
                                    </t>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- ================= Kanban Inheritance for Event ================= -->
        <record id="event_application_event_kanban_inherit" model="ir.ui.view">
            <field name="name">event.application.event.kanban.inherit</field>
            <field name="model">event.event</field>
            <field name="inherit_id" ref="event.view_event_kanban"/>
            <field name="arch" type="xml">
                <!-- Add is_published toggle below the record bottom -->
                <xpath expr="//div[contains(@class, 'o_kanban_record_bottom')]" position="after">
                    <div class="border-top mt-2 pt-2">
                        <field name="is_published" widget="boolean_toggle"/>
                        <t t-if="record.is_published.raw_value">Published</t>
                        <t t-else="">Not Published</t>
                    </div>
                </xpath>

                <!-- Add date display inside the card top-left -->
                <xpath expr="//div[contains(@class, 'o_kanban_content')]" position="inside">
                    <div class="col-4 text-bg-primary p-2 text-center d-flex flex-column justify-content-center">
                        <div t-esc="luxon.DateTime.fromISO(record.date_begin.raw_value).toFormat('d')" class="o_event_fontsize_20"/>
                        <div>
                            <t t-esc="luxon.DateTime.fromISO(record.date_begin.raw_value).toFormat('MMM yyyy')"/>
                        </div>
                    </div>
                </xpath>
            </field>
        </record>

        <!-- ================= Actions ================= -->
        <record id="action_event_application" model="ir.actions.act_window">
            <field name="name">Event Applications</field>
            <field name="res_model">event.application</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="context">{'search_default_submitted': 1}</field>
        </record>

        <record id="action_event_application_to_review" model="ir.actions.act_window">
            <field name="name">To Review</field>
            <field name="res_model">event.application</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('state','=','submitted')]</field>
        </record>

        <!-- ================= Menu Items ================= -->
        <menuitem id="menu_event_application_root" 
                  name="Applications" 
                  parent="event.event_main_menu" 
                  groups="base.group_user"
                  sequence="20"/>
        <menuitem id="menu_event_application_to_review" 
                  name="To Review" 
                  parent="menu_event_application_root" 
                  action="action_event_application_to_review" 
                  groups="base.group_user"
                  sequence="5"/>
        <menuitem id="menu_event_application" 
                  name="All Applications" 
                  parent="menu_event_application_root" 
                  action="action_event_application" 
                  groups="base.group_user"
                  sequence="10"/>
    </data>
</odoo>

