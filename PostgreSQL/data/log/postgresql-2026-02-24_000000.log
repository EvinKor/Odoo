	                    FROM (VALUES (1514, '{"en_US": "<data inherit_id=\"website_event.events_list\">\n        <xpath expr=\"//t[@t-call=''website.record_cover'']/meta[@itemprop=''startDate'']\" position=\"after\">\n            <t t-if=\"''card_bg_image'' in event._fields and event.card_bg_image\">\n                <div class=\"o_wevent_card_bg\" t-attf-style=\"background-image: url(#{image_data_uri(event.card_bg_image)});\"/>\n            </t>\n            <t t-if=\"''badge_image'' in event._fields and event.badge_image\">\n                <img t-att-src=\"image_data_uri(event.badge_image)\" alt=\"Badge\" class=\"o_wevent_badge_overlay\"/>\n            </t>\n        </xpath>\n        <xpath expr=\"//t[@t-call=''website.record_cover'']\" position=\"after\">\n            <style>\n                .o_wevent_card_bg {\n                    position: absolute;\n                    inset: 0;\n                    background-size: cover;\n                    background-position: center;\n                    z-index: 0;\n                    pointer-events: none;\n                }\n                .o_wevent_card_bg ~ * {\n                    position: relative;\n                    z-index: 1;\n                }\n                .o_record_cover_container:has(.o_wevent_card_bg) .o_record_cover_image {\n                    background-image: none !important;\n                }\n                .o_wevent_badge_overlay {\n                    position: absolute;\n                    top: 12px;\n                    left: 12px;\n                    max-height: 64px;\n                    width: auto;\n                    filter: drop-shadow(0 2px 6px rgba(0,0,0,0.25));\n                    border-radius: 6px;\n                }\n            </style>\n        </xpath>\n    </data>"}', NULL, '2026-02-24 03:54:04.068694', 2)) AS "__tmp"("id", "arch_db", "arch_prev", "write_date", "write_uid")
	                    WHERE "ir_ui_view"."id" = "__tmp"."id"
	                
