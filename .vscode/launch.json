{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run Odoo Backend",
      "type": "python",
      "request": "launch",
      "program": "${workspaceFolder}/server/odoo-bin", 
      "args": [
        "-c",
        "${workspaceFolder}/odoo.conf"
      ],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}",
      "env": {
        "PYTHONPATH": "${workspaceFolder}"
      },
      "justMyCode": true
    },
    {
      "name": "Run React Frontend",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/node_modules/vite/bin/vite.js",
      "args": [],
      "cwd": "${workspaceFolder}/appointment",
      "console": "integratedTerminal",
      "internalConsoleOptions": "neverOpen"
    }
  ]
}
