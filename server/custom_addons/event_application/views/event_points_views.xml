<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_event_points_wallet_tree" model="ir.ui.view">
            <field name="name">event.points.wallet.tree</field>
            <field name="model">event.points.wallet</field>
            <field name="arch" type="xml">
                <list string="Points Wallets">
                    <field name="partner_id"/>
                    <field name="balance"/>
                </list>
            </field>
        </record>

        <record id="view_event_points_wallet_form" model="ir.ui.view">
            <field name="name">event.points.wallet.form</field>
            <field name="model">event.points.wallet</field>
            <field name="arch" type="xml">
                <form string="Points Wallet">
                    <sheet>
                        <group>
                            <field name="partner_id"/>
                            <field name="balance" readonly="1"/>
                        </group>
                        <notebook>
                            <page string="Transactions">
                                <field name="transaction_ids">
                                    <list editable="bottom">
                                        <field name="create_date" readonly="1"/>
                                        <field name="transaction_type"/>
                                        <field name="amount"/>
                                        <field name="reason"/>
                                        <field name="reference"/>
                                    </list>
                                </field>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_event_points_wallet_search" model="ir.ui.view">
            <field name="name">event.points.wallet.search</field>
            <field name="model">event.points.wallet</field>
            <field name="arch" type="xml">
                <search string="Points Wallets">
                    <field name="partner_id"/>
                    <filter string="Positive Balance" name="positive_balance" domain="[('balance', '>', 0)]"/>
                </search>
            </field>
        </record>

        <record id="action_event_points_wallet" model="ir.actions.act_window">
            <field name="name">Points Wallets</field>
            <field name="res_model">event.points.wallet</field>
            <field name="view_mode">list,form</field>
        </record>

        <record id="view_event_points_transaction_tree" model="ir.ui.view">
            <field name="name">event.points.transaction.tree</field>
            <field name="model">event.points.transaction</field>
            <field name="arch" type="xml">
                <list string="Points Transactions">
                    <field name="create_date"/>
                    <field name="partner_id"/>
                    <field name="transaction_type"/>
                    <field name="amount"/>
                    <field name="reason"/>
                    <field name="reference"/>
                </list>
            </field>
        </record>

        <record id="view_event_points_transaction_form" model="ir.ui.view">
            <field name="name">event.points.transaction.form</field>
            <field name="model">event.points.transaction</field>
            <field name="arch" type="xml">
                <form string="Points Transaction">
                    <sheet>
                        <group>
                            <field name="wallet_id"/>
                            <field name="partner_id" readonly="1"/>
                            <field name="transaction_type"/>
                            <field name="amount"/>
                            <field name="reason"/>
                            <field name="reference"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_event_points_transaction_search" model="ir.ui.view">
            <field name="name">event.points.transaction.search</field>
            <field name="model">event.points.transaction</field>
            <field name="arch" type="xml">
                <search string="Points Transactions">
                    <field name="partner_id"/>
                    <field name="reason"/>
                    <filter string="Credits" name="credits" domain="[('transaction_type', '=', 'credit')]"/>
                    <filter string="Debits" name="debits" domain="[('transaction_type', '=', 'debit')]"/>
                </search>
            </field>
        </record>

        <record id="action_event_points_transaction" model="ir.actions.act_window">
            <field name="name">Points Transactions</field>
            <field name="res_model">event.points.transaction</field>
            <field name="view_mode">list,form</field>
        </record>

        <menuitem id="menu_event_points_wallet"
                  name="Points Wallets"
                  parent="event_application.menu_event_application_root"
                  action="action_event_points_wallet"
                  groups="base.group_system"
                  sequence="30"/>

        <menuitem id="menu_event_points_transaction"
                  name="Points Transactions"
                  parent="event_application.menu_event_application_root"
                  action="action_event_points_transaction"
                  groups="base.group_system"
                  sequence="40"/>
    </data>
</odoo>

