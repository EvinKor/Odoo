<odoo>
    <record id="view_dental_points_wallet_tree" model="ir.ui.view">
        <field name="name">dental.points.wallet.tree</field>
        <field name="model">dental.points.wallet</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="balance"/>
            </list>
        </field>
    </record>

    <record id="view_dental_points_wallet_form" model="ir.ui.view">
        <field name="name">dental.points.wallet.form</field>
        <field name="model">dental.points.wallet</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="balance" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Transactions">
                            <field name="transaction_ids" context="{'default_wallet_id': id, 'default_partner_id': partner_id}">
                                <list editable="bottom">
                                    <field name="create_date" readonly="1"/>
                                    <field name="amount"/>
                                    <field name="transaction_type"/>
                                    <field name="reason"/>
                                    <field name="reference"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_dental_points_tx_tree" model="ir.ui.view">
        <field name="name">dental.points.transaction.tree</field>
        <field name="model">dental.points.transaction</field>
        <field name="arch" type="xml">
            <list>
                <field name="create_date"/>
                <field name="partner_id"/>
                <field name="amount"/>
                <field name="transaction_type"/>
                <field name="reason"/>
                <field name="reference"/>
            </list>
        </field>
    </record>

    <record id="view_dental_points_tx_form" model="ir.ui.view">
        <field name="name">dental.points.transaction.form</field>
        <field name="model">dental.points.transaction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="wallet_id"/>
                        <field name="partner_id"/>
                        <field name="amount"/>
                        <field name="transaction_type"/>
                        <field name="reason"/>
                        <field name="reference"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_dental_points_wallet" model="ir.actions.act_window">
        <field name="name">Points Wallets</field>
        <field name="res_model">dental.points.wallet</field>
        <field name="view_mode">list,form</field>
        <field name="groups_id" eval="[(4, ref('base.group_system'))]"/>
    </record>

    <record id="action_dental_points_tx" model="ir.actions.act_window">
        <field name="name">Points Transactions</field>
        <field name="res_model">dental.points.transaction</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ticket2u_dental_root" name="Ticket2U Dental" sequence="35" groups="base.group_user"/>
    <menuitem id="menu_ticket2u_dental_points" name="Points Transactions" parent="menu_ticket2u_dental_root" action="action_dental_points_tx" sequence="20" groups="base.group_user"/>
    <menuitem id="menu_ticket2u_dental_wallets" name="Wallets" parent="menu_ticket2u_dental_root" action="action_dental_points_wallet" sequence="30" groups="base.group_system"/>
</odoo>
