<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_cancel_wizard_form" model="ir.ui.view">
        <field name="name">event.cancel.wizard.form</field>
        <field name="model">event.cancel.wizard</field>
        <field name="arch" type="xml">
            <form string="Cancel Event">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        This event has attendees. If you cancel it, you can choose whether to refund all attendee credits.
                    </div>
                    <group>
                        <field name="event_id" readonly="1"/>
                        <field name="target_stage_id" readonly="1"/>
                        <field name="attendee_count" readonly="1"/>
                        <field name="refund_points"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm_cancel" string="Cancel Event" type="object" class="btn btn-primary"/>
                    <button string="Close" special="cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
