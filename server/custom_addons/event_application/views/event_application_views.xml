<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <!-- Access Rights -->
        <record id="access_event_application_user" model="ir.model.access">
            <field name="name">event.application.user</field>
            <field name="model_id" ref="model_event_application"/>
            <field name="group_id" ref="base.group_portal"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="access_event_application_public" model="ir.model.access">
            <field name="name">event.application.public</field>
            <field name="model_id" ref="model_event_application"/>
            <field name="group_id" ref="base.group_public"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="access_event_application_manager" model="ir.model.access">
            <field name="name">event.application.manager</field>
            <field name="model_id" ref="model_event_application"/>
            <field name="group_id" ref="base.group_system"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- Image tree for application images -->
        <!-- Image list for application images -->
        <record id="view_event_application_image_tree" model="ir.ui.view">
            <field name="name">event.application.image.list</field>
            <field name="model">event.application.image</field>
            <field name="arch" type="xml">
                <list editable="bottom" string="Gallery Images">
                    <field name="sequence" widget="handle"/>
                    <field name="name"/>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <button name="action_set_thumbnail"
                            type="object"
                            string="Set as thumbnail"
                            class="btn btn-sm btn-outline-primary"/>
                    <field name="application_id" invisible="1"/>
                </list>
            </field>
        </record>

        <!-- Form view for single gallery image (with Set as Thumbnail action) -->
        <record id="view_event_application_image_form" model="ir.ui.view">
            <field name="name">event.application.image.form</field>
            <field name="model">event.application.image</field>
            <field name="arch" type="xml">
                <form string="Gallery Image">
                    <header>
                        <button name="action_set_thumbnail" type="object" string="Set as thumbnail" class="btn-primary"/>
                    </header>
                    <sheet>
                        <group>
                            <field name="name"/>
                            <field name="sequence"/>
                            <field name="image" widget="image" class="oe_avatar"/>
                            <field name="application_id" invisible="1"/>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Kanban view for gallery images (quick thumbnail pick) -->
        <record id="view_event_application_image_kanban" model="ir.ui.view">
            <field name="name">event.application.image.kanban</field>
            <field name="model">event.application.image</field>
            <field name="arch" type="xml">
                <kanban default_group_by="application_id">
                    <field name="name"/>
                    <field name="sequence"/>
                    <field name="image"/>
                    <field name="application_id"/>
                    <templates>
                        <t t-name="kanban-box">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_image">
                                    <img t-att-src="kanban_image('event.application.image', 'image', record.id.raw_value)"/>
                                </div>
                                <div class="o_kanban_details">
                                    <strong><field name="name"/></strong>
                                </div>
                                <div class="mt-2 d-flex gap-2">
                                    <button type="object" name="action_set_thumbnail" class="btn btn-sm btn-primary">Set as thumbnail</button>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Ticket line access (use model search to avoid xmlid lookup timing issues on upgrade) -->
        <record id="access_event_application_ticket_user" model="ir.model.access">
            <field name="name">event.application.ticket.user</field>
            <field name="model_id" search="[('model', '=', 'event.application.ticket')]"/>
            <field name="group_id" ref="base.group_portal"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="access_event_application_ticket_public" model="ir.model.access">
            <field name="name">event.application.ticket.public</field>
            <field name="model_id" search="[('model', '=', 'event.application.ticket')]"/>
            <field name="group_id" ref="base.group_public"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <record id="access_event_application_ticket_manager" model="ir.model.access">
            <field name="name">event.application.ticket.manager</field>
            <field name="model_id" search="[('model', '=', 'event.application.ticket')]"/>
            <field name="group_id" ref="base.group_system"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">1</field>
            <field name="perm_unlink">1</field>
        </record>

        <!-- Allow portal users to read and write their own events -->
        <record id="access_event_event_portal" model="ir.model.access">
            <field name="name">event.event.portal</field>
            <field name="model_id" ref="event.model_event_event"/>
            <field name="group_id" ref="base.group_portal"/>
            <field name="perm_read">1</field>
            <field name="perm_write">1</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Allow portal users to read registrations -->
        <record id="access_event_registration_portal" model="ir.model.access">
            <field name="name">event.registration.portal</field>
            <field name="model_id" ref="event.model_event_registration"/>
            <field name="group_id" ref="base.group_portal"/>
            <field name="perm_read">1</field>
            <field name="perm_write">0</field>
            <field name="perm_create">0</field>
            <field name="perm_unlink">0</field>
        </record>

        <!-- Action: Application Gallery (placed early so smart button resolves during view load) -->
        <record id="action_event_application_gallery" model="ir.actions.act_window">
            <field name="name">Application Gallery</field>
            <field name="res_model">event.application.image</field>
            <field name="view_mode">list,kanban,form</field>
            <field name="view_id" ref="event_application.view_event_application_image_tree"/>
            <field name="domain">[('application_id','=', active_id)]</field>
            <field name="context">{'default_application_id': active_id}</field>
            <field name="target">current</field>
        </record>

        <!-- List View -->
        <record id="view_event_application_tree" model="ir.ui.view">
            <field name="name">event.application.tree</field>
            <field name="model">event.application</field>
            <field name="arch" type="xml">
                <list string="Event Applications" 
                      decoration-danger="state=='submitted' and not submission_alert_seen" 
                      decoration-success="state in ('approved','published')" 
                      decoration-warning="state=='rejected'"
                      decoration-muted="state=='draft'">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="date_begin"/>
                    <field name="date_end"/>
                    <field name="venue_type"/>
                    <field name="venue_name"/>
                    <field name="full_address"/>
                    <field name="specialty_ids" widget="many2many_tags" optional="hide"/>
                    <field name="case_ids" widget="many2many_tags" optional="hide"/>
                    <field name="specialty_other_text" optional="hide"/>
                    <field name="case_other_text" optional="hide"/>
                    <field name="address_input" optional="hide"/>
                    <field name="submission_alert_seen" optional="hide"/>
                    <field name="submission_point_cost" optional="hide"/>
                    <field name="submission_points_deducted" widget="boolean_toggle" optional="hide"/>
                    <field name="state" widget="badge"/>
                    <field name="rejection_reason" optional="hide"/>
                    <field name="event_id" optional="hide"/>
                </list>
            </field>
        </record>

        <!-- Search View -->
        <record id="view_event_application_search" model="ir.ui.view">
            <field name="name">event.application.search</field>
            <field name="model">event.application</field>
            <field name="arch" type="xml">
                <search string="Event Applications">
                    <field name="name"/>
                    <field name="partner_id"/>
                    <field name="venue_name"/>
                    <field name="city"/>
                    <field name="location"/>
                    <separator/>
                    <filter string="Submitted" name="submitted" domain="[('state','=','submitted')]"/>
                    <filter string="Approved" name="approved" domain="[('state','=','approved')]"/>
                    <filter string="Published" name="published" domain="[('state','=','published')]"/>
                    <filter string="Rejected" name="rejected" domain="[('state','=','rejected')]"/>
                    <filter string="Physical Events" name="physical" domain="[('venue_type','=','physical')]"/>
                    <filter string="Online Events" name="online" domain="[('venue_type','=','online')]"/>
                    <separator/>
                    <group expand="0" string="Group By">
                        <filter string="Status" name="group_state" context="{'group_by':'state'}"/>
                        <filter string="Organizer" name="group_partner" context="{'group_by':'partner_id'}"/>
                        <filter string="Venue Type" name="group_venue_type" context="{'group_by':'venue_type'}"/>
                        <filter string="City" name="group_city" context="{'group_by':'city'}"/>
                        <filter string="Start Date" name="group_date_begin" context="{'group_by':'date_begin'}"/>
                    </group>
                </search>
            </field>
        </record>

        <!-- Form View -->
        <record id="view_event_application_form" model="ir.ui.view">
            <field name="name">event.application.form</field>
            <field name="model">event.application</field>
            <field name="arch" type="xml">
                <form string="Event Application">
                    <header>
                        <button name="action_submit" string="Submit" type="object" 
                                invisible="state != 'draft'" 
                                class="btn-primary"/>
                        <button name="action_approve" string="Approve" type="object" 
                                invisible="state != 'submitted'" 
                                class="btn-success" 
                                groups="base.group_system"/>
                        <button name="action_reject" string="Reject" type="object" 
                                invisible="state != 'submitted'" 
                                class="btn-danger" 
                                groups="base.group_system"/>
                        <button name="action_publish" string="Publish as Event" type="object" 
                                invisible="state != 'approved'" 
                                class="btn-primary" 
                                groups="base.group_system"
                                confirm="This will create a public event on your website. Continue?"/>
                        <button name="action_reset_to_draft" string="Reset to Draft" type="object" 
                                invisible="state not in ('rejected','submitted')" 
                                groups="base.group_system"/>
                        <field name="state" widget="statusbar" statusbar_visible="draft,submitted,approved,published"/>
                    </header>
                    <sheet>
                        <div class="oe_button_box" name="button_box">
                            <button name="action_open_event" type="object" 
                                    class="oe_stat_button" icon="fa-calendar" 
                                    invisible="not event_id">
                                <div class="o_field_widget o_stat_info">
                                    <span class="o_stat_text">View Event</span>
                                </div>
                            </button>
                        </div>
                        <field name="submission_alert_seen" invisible="1"/>
                        <widget name="web_ribbon" title="NEW SUBMISSION" bg_color="text-bg-danger" invisible="state != 'submitted' or submission_alert_seen"/>
                        <widget name="web_ribbon" title="Approved" bg_color="text-bg-success" invisible="state != 'approved'"/>
                        <widget name="web_ribbon" title="Published" bg_color="text-bg-primary" invisible="state != 'published'"/>
                        <widget name="web_ribbon" title="Rejected" bg_color="text-bg-danger" invisible="state != 'rejected'"/>
                        
                        <group>
                            <group>
                                <field name="name"/>
                                <field name="partner_id"/>
                                <field name="venue_type"/>
                                
                                <!-- Address Input Section -->
                                <field name="address_input" 
                                       invisible="venue_type != 'physical'"
                                       colspan="2"
                                       placeholder="Type the complete address: house number, street, city, ZIP code, country, etc."
                                       widget="text"/>
                                
                                <field name="venue_name" invisible="venue_type != 'physical'"/>
                                <field name="building_name" invisible="venue_type != 'physical'"/>
                                <field name="street_address" invisible="venue_type != 'physical'"/>
                                <field name="street_address2" invisible="venue_type != 'physical'"/>
                                <field name="district" invisible="venue_type != 'physical'"/>
                                <field name="floor" invisible="venue_type != 'physical'"/>
                                <field name="unit_no" invisible="venue_type != 'physical'"/>
                                <field name="city" invisible="venue_type != 'physical'"/>
                                <field name="state_id" invisible="venue_type != 'physical'"/>
                                <field name="zip_code" invisible="venue_type != 'physical'"/>
                                <field name="country_id" invisible="venue_type != 'physical'"/>
                                <field name="online_platform" invisible="venue_type != 'online'"/>
                                <field name="online_link" invisible="venue_type != 'online'" widget="url"/>
                                <field name="specialty_ids" widget="many2many_tags"/>
                                <field name="specialty_other_text" placeholder="Other specialties (comma separated)"/>
                                <field name="case_ids" widget="many2many_tags"/>
                                <field name="case_other_text" placeholder="Other case types (comma separated)"/>
                            </group>
                            <group>
                                <field name="date_begin"/>
                                <field name="date_end"/>
                                <field name="registration_start"/>
                                <field name="registration_end"/>
                                <field name="registration_limit"/>
                                <field name="max_registrations" invisible="not registration_limit"/>
                                <field name="badge_image" widget="image"/>
                                <field name="thumbnail_image" widget="image"/>
                                <field name="event_id" readonly="1" invisible="not event_id"/>
                            </group>
                        </group>
                        
                        <notebook>
                            <page string="Description">
                                <field name="description" widget="html"/>
                            </page>
                            <page string="Tickets">
                                <field name="ticket_line_ids">
                                    <list editable="bottom">
                                        <field name="name"/>
                                        <field name="start_sale_datetime"/>
                                        <field name="end_sale_datetime"/>
                                        <field name="seats_limited"/>
                                        <field name="seats_max" invisible="not seats_limited"/>
                                        <field name="point_cost"/>
                                    </list>
                                </field>
                            </page>
                            <page string="Admin Notes" groups="base.group_system">
                                <group>
                                    <field name="submission_point_cost" readonly="1"/>
                                    <field name="submission_points_deducted" readonly="1"/>
                                    <field name="rejection_reason" invisible="state != 'rejected'"/>
                                </group>
                            </page>
                            <page string="Images">
                                <group>
                                    <group>
                                        <field name="thumbnail_image" widget="image" class="oe_avatar"/>
                                    </group>
                                </group>
                                <separator string="Gallery Images"/>
                                <field name="image_ids"
                                       context="{'default_application_id': id}"
                                       mode="list"
                                       widget="one2many_list"
                                       string="Gallery Images"/>
                            </page>
                        </notebook>
                    </sheet>
                </form>
            </field>
        </record>

        <!-- Kanban View - Fixed for Odoo 18 -->
        <record id="view_event_application_kanban" model="ir.ui.view">
            <field name="name">event.application.kanban</field>
            <field name="model">event.application</field>
            <field name="arch" type="xml">
                <kanban default_group_by="state" class="o_kanban_small_column">
                    <field name="current_event_name" string="Event Name"/>
                    <field name="name" optional="hide"/>
                    <field name="partner_id"/>
                    <field name="date_begin"/>
                    <field name="venue_name"/>
                    <field name="city"/>
                    <field name="state"/>
                    <templates>
                        <t t-name="card">
                            <div class="oe_kanban_global_click">
                                <div class="o_kanban_record_headings">
                                    <strong class="o_kanban_record_title">
                                        <field name="name"/>
                                    </strong>
                                </div>
                                <div class="o_kanban_record_body">
                                    <field name="partner_id"/>
                                    <div>
                                        <field name="date_begin" widget="date"/>
                                    </div>
                                    <div>
                                        <field name="venue_name"/>
                                    </div>
                                    <div>
                                        <field name="city"/>
                                    </div>
                                </div>
                            </div>
                        </t>
                    </templates>
                </kanban>
            </field>
        </record>

        <!-- Action -->
        <record id="action_event_application" model="ir.actions.act_window">
            <field name="name">Event Applications</field>
            <field name="res_model">event.application</field>
            <field name="view_mode">list,form</field>
            <field name="context">{'search_default_submitted': 1}</field>
            <field name="help" type="html">
                <p class="o_view_nocontent_smiling_face">
                    No event applications yet
                </p>
                <p>
                    Event applications submitted by users will appear here.
                </p>
            </field>
        </record>

        <!-- Menu - Top Level with explicit groups -->
        <menuitem id="menu_event_application_root" 
          name="Applications" 
          parent="event.event_main_menu" 
          groups="base.group_user"
          sequence="20"/>
        <menuitem id="menu_event_application" 
                name="All Applications" 
                parent="menu_event_application_root" 
                action="action_event_application" 
                groups="base.group_user"
                sequence="10"/>
    </data>
</odoo>
