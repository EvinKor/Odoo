<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <template id="portal_frontend_layout_points_badge" inherit_id="portal.frontend_layout" name="Portal Header Points Badge">
        <xpath expr="//t[@t-call='portal.user_dropdown']" position="before">
            <li t-if="not request.env.user._is_public()"
                t-nocache="Show the live points balance for the current signed-in user."
                class="nav-item d-flex align-items-center">
                <span class="nav-link pe-2 pe-lg-3">
                    <span class="badge rounded-pill bg-warning text-dark border px-3 py-2 js-event-portal-points-badge"
                          data-points-endpoint="/event/apply/points/balance">
                        <i class="fa fa-star me-1"/>
                        <span class="fw-semibold me-1">Snabbb Credit:</span>
                        <span class="js-event-portal-points-value">...</span>
                        <span class="ms-1">points</span>
                    </span>
                </span>
            </li>
        </xpath>
    </template>
</odoo>
