<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_delete_event_wizard_form" model="ir.ui.view">
            <field name="name">delete.event.wizard.form</field>
            <field name="model">delete.event.wizard</field>
            <field name="arch" type="xml">
                <form string="Delete Event">
                    <group>
                        <field name="event_id" invisible="1"/>
                        <div class="alert alert-warning mb-0" role="alert">
                            This will permanently delete the event and all linked registrations.
                        </div>
                        <field name="refund_points"/>
                    </group>
                    <footer>
                        <button string="Delete Event" name="action_confirm_delete" type="object" class="btn-danger"/>
                        <button string="Cancel" class="btn-secondary" special="cancel"/>
                    </footer>
                </form>
            </field>
        </record>
    </data>
</odoo>
