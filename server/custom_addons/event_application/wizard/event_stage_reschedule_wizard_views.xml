<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_event_stage_reschedule_wizard_form" model="ir.ui.view">
        <field name="name">event.stage.reschedule.wizard.form</field>
        <field name="model">event.stage.reschedule.wizard</field>
        <field name="arch" type="xml">
            <form string="Event Warning">
                <sheet>
                    <div class="alert alert-warning" role="alert">
                        This event status does not match its current dates or visibility.
                        You can modify the event details below to fix that mismatch, or leave it as it is and continue anyway.
                    </div>
                    <group>
                        <field name="event_id" readonly="1"/>
                        <field name="target_stage_id" readonly="1"/>
                        <field name="date_begin"/>
                        <field name="date_end"/>
                    </group>
                </sheet>
                <footer>
                    <button name="action_confirm" string="Modify Event" type="object" class="btn btn-primary"/>
                    <button name="action_leave_as_is" string="Leave It As Is" type="object" class="btn btn-secondary"/>
                    <button string="Cancel" special="cancel" class="btn btn-secondary"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
