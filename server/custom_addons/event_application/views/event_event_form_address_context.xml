<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_event_hide_from_users" model="ir.actions.server">
        <field name="name">Hide Event from Users</field>
        <field name="model_id" ref="event.model_event_event"/>
        <field name="binding_model_id" ref="event.model_event_event"/>
        <field name="state">code</field>
        <field name="code">records.write({'website_published': False, 'is_published': False})</field>
    </record>

    <record id="action_event_show_to_users" model="ir.actions.server">
        <field name="name">Show Event to Users</field>
        <field name="model_id" ref="event.model_event_event"/>
        <field name="binding_model_id" ref="event.model_event_event"/>
        <field name="state">code</field>
        <field name="code">records.write({'website_published': True, 'is_published': True})</field>
    </record>

    <record id="action_open_delete_event_wizard" model="ir.actions.act_window">
        <field name="name">Delete Event</field>
        <field name="res_model">delete.event.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="context">{'default_event_id': active_id}</field>
    </record>

    <record id="event_event_view_form_address_only" model="ir.ui.view">
        <field name="name">event.event.form.address.only</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <button name="%(event_application.action_event_hide_from_users)d"
                        string="Hide from Users"
                        type="action"
                        class="btn-secondary"
                        invisible="not active or not is_published"
                        confirm="Hide this event from public users without deleting it?"/>
                <button name="%(event_application.action_event_show_to_users)d"
                        string="Show to Users"
                        type="action"
                        class="btn-secondary"
                        invisible="not active or is_published"/>
                <button name="action_unarchive"
                        string="Restore Event"
                        type="object"
                        class="btn-secondary"
                        invisible="active"/>
            </xpath>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_view_registrations_portal"
                        type="object"
                        class="oe_stat_button"
                        icon="fa-users"
                        help="Open all registrations linked to this event, including archived ones.">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_text">Registrations</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//group[@name='right_event_details']/field[@name='company_id']" position="after">
                <field name="venue_type"/>
                <field name="venue_name" invisible="venue_type != 'physical'"/>
                <field name="building_name" invisible="venue_type != 'physical'"/>
                <field name="street_address" invisible="venue_type != 'physical'"/>
                <field name="street_address2" invisible="venue_type != 'physical'"/>
                <field name="district" invisible="venue_type != 'physical'"/>
                <field name="floor" invisible="venue_type != 'physical'"/>
                <field name="unit_no" invisible="venue_type != 'physical'"/>
                <field name="city" invisible="venue_type != 'physical'"/>
                <field name="state_id" invisible="venue_type != 'physical'"/>
                <field name="zip_code" invisible="venue_type != 'physical'"/>
                <field name="country_id" invisible="venue_type != 'physical'"/>
                <field name="full_address" invisible="venue_type != 'physical'" readonly="1" widget="text"/>
                <field name="online_platform" string="Platform" invisible="venue_type != 'online'" placeholder="Zoom, Google Meet, Microsoft Teams"/>
                <field name="online_link" string="Website" invisible="venue_type != 'online'" placeholder="Meeting link or website URL" widget="url"/>
            </xpath>
            <xpath expr="//field[@name='address_id']" position="attributes">
                <attribute name="context">{'show_address_only': True, 'show_address': True}</attribute>
            </xpath>
        </field>
    </record>

    <record id="event_event_view_tree_venue_fields" model="ir.ui.view">
        <field name="name">event.event.tree.venue.fields</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.view_event_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="venue_type" optional="show"/>
                <field name="venue_name" optional="show"/>
                <field name="district" optional="hide"/>
                <field name="city" optional="show"/>
                <field name="address_input" optional="hide"/>
            </xpath>
        </field>
    </record>

    <record id="action_event_view_archived" model="ir.actions.act_window">
        <field name="name">Archived Events</field>
        <field name="res_model">event.event</field>
        <field name="view_mode">kanban,calendar,list,form,pivot,graph,activity</field>
        <field name="search_view_id" ref="event.view_event_search"/>
        <field name="domain">[('active', '=', False)]</field>
        <field name="context">{'active_test': False, 'search_default_filter_inactive': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No archived events
            </p>
            <p>
                Archived events are kept here so they stay out of the public event page without losing registration history.
            </p>
        </field>
    </record>

    <menuitem id="menu_event_event_archived"
              name="Archived Events"
              parent="event.event_main_menu"
              action="action_event_view_archived"
              groups="event.group_event_user"
              sequence="35"/>

    <record id="event_event_view_quick_create_venue_fields" model="ir.ui.view">
        <field name="name">event.event.form.quick.create.venue.fields</field>
        <field name="model">event.event</field>
        <field name="inherit_id" ref="event.event_event_view_form_quick_create"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='date_end']" position="after">
                <field name="venue_type"/>
                <field name="address_input"
                       invisible="venue_type != 'physical'"
                       colspan="2"
                       placeholder="Type the complete address: house number, street, city, ZIP code, country, etc."
                       widget="text"/>
                <field name="venue_name" invisible="venue_type != 'physical'" placeholder="Venue Name"/>
                <field name="building_name" invisible="venue_type != 'physical'" placeholder="Building Name"/>
                <field name="street_address" invisible="venue_type != 'physical'" placeholder="Street Address"/>
                <field name="street_address2" invisible="venue_type != 'physical'" placeholder="Address Line 2"/>
                <field name="district" invisible="venue_type != 'physical'" placeholder="District / Area"/>
                <field name="floor" invisible="venue_type != 'physical'" placeholder="Floor / Level"/>
                <field name="unit_no" invisible="venue_type != 'physical'" placeholder="Unit / Suite"/>
                <field name="city" invisible="venue_type != 'physical'" placeholder="City"/>
                <field name="state_id" invisible="venue_type != 'physical'"/>
                <field name="zip_code" invisible="venue_type != 'physical'" placeholder="ZIP"/>
                <field name="country_id" invisible="venue_type != 'physical'"/>
                <field name="online_platform" string="Platform" invisible="venue_type != 'online'" placeholder="Zoom, Google Meet, Microsoft Teams"/>
                <field name="online_link" string="Website" invisible="venue_type != 'online'" placeholder="Meeting link or website URL" widget="url"/>
            </xpath>
        </field>
    </record>

</odoo>
